OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required on every deployment, including Vercel. Chat fails closed when any of these are missing.
# Generate with: openssl rand -base64 32
# Do not prefix with NEXT_PUBLIC_.
SIDEQUEST_ACCESS_TOKEN=

# Upstash Redis REST credentials. On Vercel, create a Redis database from the Marketplace
# and copy the REST URL and token into the project environment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
